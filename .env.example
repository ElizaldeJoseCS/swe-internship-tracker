# Copy this file to .env and fill in the values.

# --- Google Sheets ---------------------------------------------------------
# The spreadsheet ID from your URL, e.g. the "1kHi..." part of:
#   https://docs.google.com/spreadsheets/d/<GSHEET_ID>/edit
# You can paste either the bare ID or the full URL — the code extracts the ID.
GSHEET_ID=
SHEET_NAME=Internships
GAME_DEV_SHEET_NAME=Game Dev
NEW_GRAD_SHEET_NAME=New Grad
CREDENTIALS_FILE=config/google_credentials.json

# --- Which sources to scrape (true/false) ----------------------------------
SCRAPE_SIMPLIFY=true
SCRAPE_SIMPLIFY_NEWGRAD=true
SCRAPE_ZAPPLY=true
SCRAPE_GREENHOUSE=true
SCRAPE_LEVER=true
SCRAPE_LINKEDIN=false
SCRAPE_INDEED=false
SCRAPE_GAMEJOBS=true

# --- Company boards for Greenhouse / Lever ---------------------------------
# Comma-separated slugs. For Greenhouse use the name that appears in
# https://boards.greenhouse.io/<NAME>. For Lever use https://jobs.lever.co/<NAME>.
# Examples: stripe, airbnb, coinbase, etc.
GREENHOUSE_BOARDS=
LEVER_BOARDS=

# --- Optional: restrict to certain companies (comma-separated, case-insensitive)
# Leave empty to keep everything.
TARGET_COMPANIES=

# --- Scraping behavior -----------------------------------------------------
REQUEST_TIMEOUT=15
FILTER_TITLES=true

# --- GameJobs.co (game-industry board) --------------------------------------
# How many feed pages to scrape (more = more jobs, more requests).
# Game internships are sparse and spread out, so ~8 pages is a good default.
GAME_MAX_PAGES=8
# Set to true to keep ALL postings (art/design/marketing), not just SWE ones.
GAME_KEEP_ALL=false

# --- Optional: session cookie to bypass LinkedIn/Indeed bot checks -----------
# After logging into LinkedIn in your browser, copy the "li_at" (or full
# Cookie header) value here. Only needed if those sources return no results.
LINKEDIN_COOKIE=
