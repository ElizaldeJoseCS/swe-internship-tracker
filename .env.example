# Email destination
ALERT_EMAIL=je2398157@gmail.com

# Gmail account used to SEND the alerts.
# This should normally be the same Gmail account as ALERT_EMAIL.
SENDER_EMAIL=je2398157@gmail.com

# Gmail App Password, NOT your normal Gmail password.
EMAIL_PASSWORD=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# First run: false = record current jobs without emailing them.
# Set true only if you intentionally want alerts for everything currently listed.
SEND_EXISTING_ON_FIRST_RUN=false

# Max alerts sent in one GitHub Actions run.
MAX_EMAILS_PER_RUN=25

# Sources
SCRAPE_SIMPLIFY=true
SCRAPE_SIMPLIFY_NEWGRAD=true
SCRAPE_ZAPPLY=true
SCRAPE_GAMEJOBS=true

# These can be enabled if you configure their boards / credentials.
SCRAPE_GREENHOUSE=false
SCRAPE_LEVER=false
SCRAPE_LINKEDIN=false
SCRAPE_INDEED=false

# Optional direct ATS boards, comma-separated.
GREENHOUSE_BOARDS=
LEVER_BOARDS=

# Simplify sources. Update these if Simplify changes season/repo names.
SIMPLIFY_INTERNSHIP_REPO=https://raw.githubusercontent.com/SimplifyJobs/Summer2027-Internships/dev/README.md
SIMPLIFY_NEWGRAD_REPO=https://raw.githubusercontent.com/SimplifyJobs/New-Grad-Positions/dev/README.md
